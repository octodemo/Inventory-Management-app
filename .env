# Database connection
DATABASE_URL="file:./dev.db"

# Server port
PORT=3000

# Authentication (workshop values only — replace in real deployments)
AUTH_JWT_SECRET="workshop-development-signing-key-change-me"
AUTH_SESSION_TTL_SECONDS=28800

# Seed users mirrored from the IAM framework (see workshop-stack.md)
SEED_ADMIN_EMAIL="admin@stationery.local"
SEED_ADMIN_PASSWORD="Admin@1234"
SEED_USER_EMAIL="user@stationery.local"
SEED_USER_PASSWORD="User@1234"

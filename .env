# Database connection
DATABASE_URL="file:./dev.db"

# Server port
PORT=3000

# Authentication
# AUTH_JWT_SECRET is intentionally not set here: outside production the server
# generates a random per-process signing key. It MUST be provided by the
# deployment environment when NODE_ENV=production.
AUTH_SESSION_TTL_SECONDS=28800

# Seed users mirrored from the IAM framework. Set passwords locally before seeding.
SEED_ADMIN_EMAIL="admin@stationery.local"
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL="user@stationery.local"
SEED_USER_PASSWORD=

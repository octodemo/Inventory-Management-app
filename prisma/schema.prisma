// Prisma schema for Stationery Inventory Management
// Database models will be added by implement-agent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ItemHierarchy {
  id        Int             @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    ItemHierarchy?  @relation("HierarchyNesting", fields: [parentId], references: [id])
  children  ItemHierarchy[] @relation("HierarchyNesting")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

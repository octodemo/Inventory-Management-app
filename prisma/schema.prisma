// Prisma schema for Stationery Inventory Management
// Database models will be added by implement-agent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UsageRecord {
  id             Int      @id @default(autoincrement())
  itemName       String
  branchName     String
  quantity       Float
  usageDate      DateTime
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

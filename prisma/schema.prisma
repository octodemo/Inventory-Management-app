// Prisma schema for Stationery Inventory Management
// Database models will be added by implement-agent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Models will be added here by implement-agent

/// Application user mirrored from the organisation's IAM framework.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  /// ADMIN or USER — stored as text because SQLite does not support enums;
  /// values are constrained by the `UserRole` type in src/types/auth.ts.
  role         String
  /// Scrypt hash (`salt:hash`) of the credential synchronised from IAM.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

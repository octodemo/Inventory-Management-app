// Prisma schema for Stationery Inventory Management
// Database models will be added by implement-agent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RegionalOffice {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
